# Copy to .env on the server. Never commit .env or put these values in GitHub
# Actions workflow files. Inject secrets via the NAS env file or Actions secrets.

# Public URL of this deployment (no trailing slash)
APP_BASE_URL=https://zepplox.example.com

# Listen port (mapped by Docker)
PORT=8456

# Fernet key (url-safe base64, 32 bytes). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# Session cookie signing key. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# MariaDB — create the empty database yourself; tables are created on startup
DB_HOST=192.168.1.10
DB_PORT=3306
DB_NAME=zepplox
DB_USER=zepplox
DB_PASSWORD=

# Microsoft 365 SMTP relay (IP connector): no username/password
SMTP_HOST=contoso-com.mail.protection.outlook.com
SMTP_PORT=25
SMTP_STARTTLS=true
SMTP_FROM=zepplox@example.com
SMTP_FROM_NAME=ZeppLox

# Login: only these addresses may request an OTP. Comma-separated, case-insensitive.
ALLOWED_EMAILS=you@example.com

# Livelox OAuth (request client_id from info@livelox.com). Leave empty until issued.
LIVELOX_CLIENT_ID=
# Optional; defaults to {APP_BASE_URL}/oauth/livelox/callback
LIVELOX_REDIRECT_URI=

# Sync
SYNC_LOOKBACK_HOURS=2
LOG_RETENTION_DAYS=7
OTP_TTL_SECONDS=600
