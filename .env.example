# Copy to .env on the server. Never commit .env or put these values in GitHub
# Actions workflow files.

# Public URL of this deployment (no trailing slash)
APP_BASE_URL=https://zepplox.example.com

# Listen port (mapped by Docker)
PORT=8456

# Fernet key (url-safe base64, 32 bytes). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# Session cookie signing key. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Existing MariaDB (empty database; tables are created on startup)
DB_HOST=192.168.1.10
DB_PORT=3306
DB_NAME=zepplox
DB_USER=zepplox
DB_PASSWORD=

# Outbound mail. SMTP_ENCRYPTION is starttls, ssl, or none.
# Leave SMTP_USER / SMTP_PASSWORD empty for IP-based relay (no AUTH).
#
# Microsoft 365 IP connector:
#   SMTP_HOST=contoso-com.mail.protection.outlook.com
#   SMTP_PORT=25
#   SMTP_ENCRYPTION=starttls
#
# Authenticated submission (typical 587):
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587
#   SMTP_ENCRYPTION=starttls
#   SMTP_USER=zepplox@example.com
#   SMTP_PASSWORD=
#
# Implicit TLS (typical 465):
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=465
#   SMTP_ENCRYPTION=ssl
SMTP_HOST=
SMTP_PORT=25
SMTP_ENCRYPTION=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=zepplox@example.com
SMTP_FROM_NAME=ZeppLox

# From info@livelox.com (user-delegated OAuth, scope routes.import)
LIVELOX_CLIENT_ID=
# Optional; defaults to {APP_BASE_URL}/oauth/livelox/callback
# LIVELOX_REDIRECT_URI=https://zepplox.example.com/oauth/livelox/callback

# Automatic Intervals → Livelox poll. 0 = off (local default). The Docker
# image sets 30. Users with sync turned off in Settings are skipped.
# Users are spread across the interval (slot = user id modulo minutes).
# SYNC_INTERVAL_MINUTES=30
# Pause between two users in the same slot (seconds)
# SYNC_USER_GAP_SECONDS=2

# Comma-separated e-mails that can open /admin. Empty = nobody.
# ADMIN_EMAILS=you@example.com

# OTP rate limits (open registration)
OTP_TTL_SECONDS=600
OTP_MAX_PER_WINDOW=3
OTP_WINDOW_SECONDS=900
OTP_MAX_PER_IP=10
